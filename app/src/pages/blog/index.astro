---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RevampHero from '../../components/RevampHero.astro';
import CTA from '../../components/CTA.astro';
import { breadcrumbSchema, insights } from '../../data/site';

const title = 'Business Strategy, Methodology and Market Insights | DivineLab Worx';
const description =
  'Evidence-led insights on business strategy methodology, international market entry, product commercialisation, transformation, growth and critical infrastructure.';
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/blog"
  schema={breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Insights', path: '/blog' }])}
  pageClass="revamp-page"
>
  <RevampHero
    eyebrow="Insights"
    title="Practical thinking on strategy, method and <em>market action.</em>"
    support="Evidence-led perspectives for leaders making market, transformation and investment decisions under real operating constraints."
    primaryLabel="Discuss a mandate"
    primaryHref="/contact"
    secondaryLabel="See capabilities"
    secondaryHref="/capabilities"
    code="INS / 01"
  />

  <section class="revamp-answer">
    <div class="shell revamp-answer-grid" data-reveal>
      <div>
        <p class="revamp-eyebrow">Editorial standard</p>
        <h2>What will you find here?</h2>
      </div>
      <p>
        Practical analysis on business strategy methodology, market entry, product commercialisation, channels, transformation, growth and infrastructure. Each note starts with the answer and explains the decision logic behind it.
      </p>
    </div>
  </section>

  <section class="revamp-section">
    <div class="shell">
      <div class="editorial-list">
        {insights.map((item, index) => (
          <article class="editorial-row" data-reveal>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <p class="revamp-eyebrow">{item.category} / {item.readTime}</p>
              <h3>{item.title}</h3>
            </div>
            <p>{item.excerpt}</p>
            <a href={`/blog/${item.slug}`} aria-label={`Read ${item.title}`}>↗</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTA
    eyebrow="Need an answer for your business?"
    title="Put the operating question on the table."
    copy="We can translate the framework into a contained decision, evidence register and next-step pathway for your organisation."
  />
</BaseLayout>
