---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RevampHero from '../../components/RevampHero.astro';
import CTA from '../../components/CTA.astro';
import { breadcrumbSchema, insights, site } from '../../data/site';

export function getStaticPaths() {
  return insights.map((insight) => ({
    params: { slug: insight.slug },
    props: { insight },
  }));
}

const { insight } = Astro.props;
const title = `${insight.title} | DivineLab Worx`;
const description = insight.excerpt;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: insight.title,
  description: insight.excerpt,
  datePublished: insight.published,
  dateModified: insight.published,
  author: {
    '@type': 'Person',
    name: 'Dainu Devis',
    url: `${site.url}/about`,
  },
  publisher: { '@id': `${site.url}/#organisation` },
  mainEntityOfPage: `${site.url}/blog/${insight.slug}`,
  inLanguage: 'en-AU',
};
const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Insights', path: '/blog' },
    { name: insight.title, path: `/blog/${insight.slug}` },
  ]),
  articleSchema,
];
---

<BaseLayout title={title} description={description} schema={schema} article pageClass="revamp-page">
  <RevampHero
    eyebrow={`${insight.category} / ${insight.readTime}`}
    title={insight.title}
    support={insight.excerpt}
    primaryLabel="Discuss this issue"
    primaryHref="/contact"
    secondaryLabel="All insights"
    secondaryHref="/blog"
    code="BRF / INTL"
  />

  <section class="revamp-answer">
    <div class="shell revamp-answer-grid" data-reveal>
      <div>
        <p class="revamp-eyebrow">Direct answer</p>
        <h2>The short version.</h2>
      </div>
      <p>{insight.answer}</p>
    </div>
  </section>

  <article class="revamp-section">
    <div class="shell article-grid">
      <aside class="article-sticky" data-reveal>
        <p class="revamp-eyebrow">Briefing note</p>
        <h2>{insight.title}</h2>
        <p>
          Published {new Date(insight.published).toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' })}
        </p>
      </aside>
      <div class="article-body" data-reveal>
        {insight.sections.map((section) => (
          <section>
            <h2>{section.heading}</h2>
            <p>{section.body}</p>
          </section>
        ))}
        <section>
          <h2>The decision standard</h2>
          <p>
            The objective is not to remove all uncertainty. It is to make the customer, commercial logic, evidence, dependencies and next test visible enough for a responsible decision.
          </p>
          <a class="text-link" href={insight.related.href}>{insight.related.label} <span aria-hidden="true">↗</span></a>
        </section>
      </div>
    </div>
  </article>

  <CTA
    eyebrow="Apply the thinking"
    title="Turn the framework into a decision for your organisation."
    copy="A contained engagement can establish the evidence, ownership and practical next step for the issue in front of you."
  />
</BaseLayout>
