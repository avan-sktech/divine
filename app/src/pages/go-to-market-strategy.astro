---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceLanding from '../components/ServiceLanding.astro';
import {
  breadcrumbSchema,
  faqSchema,
  goToMarketFaqs,
  serviceSchema,
} from '../data/site';

const title = 'Go-to-Market Strategy Consultants | DivineLab Worx';
const description =
  'Go-to-market strategy consulting for product and service launches across Australia and international markets. Align customer, positioning, channel and delivery.';
const path = '/go-to-market-strategy';
const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Capabilities', path: '/capabilities' },
    { name: 'Go-to-market strategy', path },
  ]),
  faqSchema(goToMarketFaqs),
  serviceSchema({
    name: 'Go-to-Market Strategy Consulting',
    path,
    description,
    serviceType: [
      'Go-to-market strategy consulting',
      'Product launch strategy',
      'Commercial strategy',
      'Route-to-market strategy',
    ],
    audience: ['Businesses entering new markets', 'International organisations', 'B2B product and service leaders'],
    offerName: 'Go-to-Market Diagnostic',
  }),
];

const audienceItems = [
  {
    title: 'Launching a new product or service',
    copy: 'You need a defined first customer, a commercial offer and a launch pathway before material spend is committed.',
  },
  {
    title: 'Entering a new segment or geography',
    copy: 'The current route to market cannot simply be copied into a different buyer, industry or geographic context.',
  },
  {
    title: 'Fixing an underperforming launch',
    copy: 'Activity is high, but pipeline, conversion, channel ownership or the economic case remains unclear.',
  },
  {
    title: 'Aligning product, sales and delivery',
    copy: 'The functions are making separate decisions and need one commercial plan with shared measures.',
  },
];

const scopeItems = [
  {
    title: 'Ideal customer and beachhead',
    copy: 'Define the buyer, urgent problem, buying group, use case and first segment where the offer has a credible right to win.',
  },
  {
    title: 'Positioning and value proposition',
    copy: 'Translate technical or operational capability into a clear commercial promise supported by evidence.',
  },
  {
    title: 'Pricing and commercial model',
    copy: 'Test willingness to pay, margin, delivery cost, partner economics and the commercial logic behind the offer.',
  },
  {
    title: 'Route to market',
    copy: 'Choose the direct, partner, distributor, retail, digital or hybrid path that fits how the customer actually buys.',
  },
  {
    title: 'Demand and sales motion',
    copy: 'Connect messages, proof, conversion points, sales roles and launch activity to a measurable pipeline outcome.',
  },
  {
    title: 'Delivery readiness',
    copy: 'Align onboarding, fulfilment, service, technology, compliance and operating ownership with the market promise.',
  },
];

const processItems = [
  {
    number: '01',
    title: 'Frame the commercial decision',
    copy: 'Set the launch objective, constraints, investment at risk and the evidence leaders need before approving the next stage.',
  },
  {
    number: '02',
    title: 'Test the market assumptions',
    copy: 'Examine customer need, buying behaviour, alternatives, price logic, channel access and delivery requirements.',
  },
  {
    number: '03',
    title: 'Design the go-to-market system',
    copy: 'Bring the offer, route, sales motion, demand plan, operating model and measures into one execution pathway.',
  },
  {
    number: '04',
    title: 'Run a controlled market test',
    copy: 'Build evidence through a pilot, launch sprint or contained activation before a national or capital-heavy commitment.',
  },
];

const comparisonItems = [
  {
    question: 'Target market',
    weak: 'A broad market category and a long list of possible customers.',
    strong: 'A named beachhead segment, buying group, urgent use case and reason to act.',
  },
  {
    question: 'Channel',
    weak: 'Use every available channel and hope activity creates reach.',
    strong: 'Choose the route that matches buying behaviour, economics and service responsibility.',
  },
  {
    question: 'Launch plan',
    weak: 'A calendar of marketing tasks disconnected from product and delivery decisions.',
    strong: 'A staged commercial plan linking offer, demand, sales, delivery and investment gates.',
  },
  {
    question: 'Success measure',
    weak: 'Traffic, awareness or partner sign-ups without revenue evidence.',
    strong: 'Customer, conversion, margin, pipeline and operating measures tied to the next decision.',
  },
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <ServiceLanding
    eyebrow="Go-to-market strategy consulting"
    title='<span class="nowrap">Go-to-market</span> strategy for an offer that has to <em>sell.</em>'
    lede="Define the customer, commercial model, channel, demand plan and delivery system before launch activity becomes expensive."
    index="GTM / INTL"
    answerQuestion="What does a go-to-market strategy consultant do?"
    answer="A go-to-market strategy consultant determines how a specific product or service should reach and convert a defined customer. The work aligns market evidence, positioning, pricing, channel, sales, demand, delivery and measurement into one accountable commercial plan."
    mediaImage="/images/editorial/marketing-operations.webp"
    mediaAlt="Marketing automation pathway from audience selection to performance analysis"
    mediaEyebrow="Demand system"
    mediaCaption="Demand generation works when targeting, campaign execution, lead routing, sales ownership and performance evidence operate as one commercial loop."
    mediaIndex="GTM / 02"
    mediaPosition="center"
    audienceHeading="Use a GTM consultant when the launch decision crosses functions."
    audienceCopy="Go-to-market work is most useful when the answer affects product, finance, sales, marketing, operations and capital at the same time."
    audienceItems={audienceItems}
    scopeHeading="One commercial system, not separate workstreams."
    scopeCopy="Every component is tested against the same target customer, conversion mechanism and economic outcome."
    scopeItems={scopeItems}
    processHeading="Move from assumptions to market evidence."
    processCopy="The process starts with the decision that needs to be made and builds only the evidence required to make it responsibly."
    processItems={processItems}
    comparisonHeading="What makes a go-to-market plan decision-ready?"
    comparisonCopy="The difference is not the number of slides. It is whether each commercial choice is specific, connected and measurable."
    comparisonItems={comparisonItems}
    faqs={goToMarketFaqs}
    faqHeading="Go-to-market strategy consulting, answered."
    ctaEyebrow="Contained first phase"
    ctaTitle="Turn the launch question into an evidence plan."
    ctaCopy="Begin with a Go-to-Market Diagnostic that clarifies the customer, offer, route, critical assumptions and next investment gate."
    ctaLabel="Request a GTM diagnostic"
    ctaHref="/contact?type=go-to-market"
    secondaryLabel="Market entry capability"
    secondaryHref="/market-entry-australia"
  />
</BaseLayout>
