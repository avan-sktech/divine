---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
---
<BaseLayout title="Privacy Policy | DivineLab Worx" description="Read how DivineLab Worx receives, uses and protects personal information provided through website enquiries and direct communications.">
  <PageHero eyebrow="Legal" title="Privacy <em>policy.</em>" lede="How DivineLab Worx handles personal information provided through this website and direct enquiries." index="LGL / 01" primaryLabel="Contact us" />
  <section class="section section-paper"><div class="shell legal">
    <p>Last updated: 24 July 2026</p>
    <h2>Information we receive</h2><p>We may receive information you choose to provide by email, phone or another direct communication, including your name, organisation, contact details and information about a potential engagement.</p>
    <h2>How information is used</h2><p>Information is used to respond to enquiries, assess whether DivineLab Worx can assist, administer an engagement and meet legal or professional obligations. We do not sell personal information.</p>
    <h2>Website enquiry form</h2><p>The enquiry form on this website prepares an email in your own email application. It does not submit your information to a third-party form provider.</p>
    <h2>Access and questions</h2><p>To ask about, correct or request access to personal information held by us, email <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>.</p>
  </div></section>
</BaseLayout>
