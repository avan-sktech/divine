---
import BaseLayout from '../layouts/BaseLayout.astro';
import RevampHero from '../components/RevampHero.astro';
import CTA from '../components/CTA.astro';
import { breadcrumbSchema, sectors, site } from '../data/site';

const title = 'Industries | Commercial Strategy Consultants | DivineLab Worx';
const description =
  'Commercial strategy for retail, manufacturing, construction and critical infrastructure across Australian and international markets.';
const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Industries', path: '/industries' },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Industries served by DivineLab Worx',
    itemListElement: sectors.map((sector, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: sector.title,
      url: `${site.url}${sector.href}`,
    })),
  },
];

/* The proof strip runs as a continuous slider, so the set is duplicated in the
   markup and the second pass is hidden from assistive tech. Descriptors state
   the nature of the relationship only -- no outcomes or figures are claimed. */
/* This vertical was published as "Sustainable and 3D homes" under the anchor
   #sustainable-homes. A fragment never reaches the server, so it cannot be 301'd
   like a path can -- an old link would silently land at the top of the page. An
   empty anchor element is not an option either: every child of .industry-feature
   becomes a grid item and a third one breaks its two-column layout. So the retired
   fragment is remapped on arrival instead. */
const retiredAnchors: Record<string, string> = { 'sustainable-homes': 'construction' };

/* A cell shows the company's logo where we hold one and falls back to its
   wordmark where we do not, which is what INTL and the accountability marker
   below still use. Each logo is prepared for the dark ground: Natridy is
   monochrome so it is flattened to white, Samaria keeps its orange and blue
   untouched with only its neutral blacks raised, and Ecostar needs no adjustment
   at all -- its wordmark is yellow and green and its tagline already white. */
const proofPoints = [
  {
    name: 'Natridy',
    note: 'Commercial and market development',
    logo: '/images/clients/natridy-light.png',
    logoWidth: 542,
    logoHeight: 176,
  },
  {
    name: 'Samaria',
    note: 'Strategic growth pathway',
    logo: '/images/clients/samaria-light.png',
    logoWidth: 300,
    logoHeight: 84,
  },
  {
    name: 'Ecostar Solar',
    note: 'Solar and battery systems',
    logo: '/images/clients/ecostar-solar.png',
    logoWidth: 641,
    logoHeight: 176,
  },
  {
    name: 'Flagman',
    note: 'Industrial safety technology',
    logo: '/images/clients/flagman-light.png',
    logoWidth: 733,
    logoHeight: 176,
  },
  {
    name: 'LaunchYourDream.AI',
    note: 'AI platform launch',
    logo: '/images/clients/lyd-light.png',
    logoWidth: 534,
    logoHeight: 176,
  },
  { name: 'INTL', note: 'Cross-market commercial context' },
  { name: '1', note: 'Accountable route to revenue' },
];

/* Travel is one cell per ~7.6s, so adding a client lengthens the loop instead of
   speeding it up. At five cells this reproduces the original 38s. */
const slideDuration = `${(proofPoints.length * 7.6).toFixed(1)}s`;

const industries = [
  {
    id: 'retail',
    code: 'RTL / 01',
    title: 'Retail',
    launch: 'Enter the market with a defined customer, credible range, compliant claims, channel economics and controlled demand test.',
    growth: 'Use customer behaviour, range performance, supplier leverage and existing channels to improve cross-sell, repeat demand and margin.',
    image: '/images/editorial/commercial-analysis.webp',
    imageAlt: 'Range performance and channel economics under review',
  },
  {
    id: 'manufacturing',
    code: 'MFG / 02',
    title: 'Manufacturing',
    launch: 'Commercialise equipment, materials or technology with the technical evidence, service model and local channel required in the target market.',
    growth: 'Turn idle capacity, process knowledge, installed relationships and technical capability into adjacent offers and stronger utilisation.',
    image: '/images/manufacturing-automation.jpg',
    imageAlt: 'Industrial automation operating in a modern manufacturing facility',
  },
  {
    id: 'construction',
    code: 'BLD / 03',
    title: 'Construction',
    launch: 'Align the customer promise, engineering evidence, approvals, supply chain, pilot project and route to repeatable delivery.',
    growth: 'Extend proven build capability into new buyer segments, project types, locations or service layers without losing delivery discipline.',
    image: '/images/construction-night.jpg',
    imageAlt: 'Large construction project representing complex built-environment delivery',
  },
  {
    id: 'infrastructure',
    code: 'INF / 04',
    title: 'Critical infrastructure',
    launch: 'Build the site, stakeholder, utility, planning and commercial evidence required to take a complex proposition toward investment.',
    growth: 'Use existing sites, technical relationships, approvals knowledge and operating capability to create the next defensible infrastructure move.',
    image: '/images/hero-infrastructure.jpg',
    imageAlt: 'Rack and cabling infrastructure inside a live facility',
  },
];
---

<BaseLayout title={title} description={description} schema={schema} pageClass="revamp-page">
  <RevampHero
    eyebrow="Industries"
    title="We work where strategy has to become <em>revenue.</em>"
    support="Commercial pathways for markets where the customer case, approvals, channel and physical delivery have to support each other."
    primaryLabel="Start an engagement"
    primaryHref="/contact"
    secondaryLabel="See capabilities"
    secondaryHref="/capabilities"
    image="/images/manufacturing-automation.jpg"
    imageAlt="Automated manufacturing environment representing complex industry delivery"
    code="IND / INTL"
  />

  <section class="revamp-answer">
    <div class="shell revamp-answer-grid" data-reveal>
      <div>
        <p class="revamp-eyebrow">Direct answer</p>
        <h2>Which industries does DivineLab Worx support?</h2>
      </div>
      <p>
        DivineLab Worx works across retail, manufacturing, construction and critical infrastructure. We support both new-market launch and growth from the assets and relationships already in place.
      </p>
    </div>
  </section>

  <section class="revamp-section">
    <div class="shell">
      <div class="revamp-heading" data-reveal>
        <div>
          <p class="revamp-eyebrow">Industry pathways</p>
          <h2>Sector context. One commercial standard.</h2>
        </div>
        <p>
          Each engagement is grounded in the realities of the industry, while keeping the customer, economics, route and evidence visible.
        </p>
      </div>
      <div class="industry-feature-grid">
        {industries.map((industry) => (
          <article class="industry-feature" id={industry.id} data-reveal>
            <figure>
              <img src={industry.image} alt={industry.imageAlt} width="1600" height="1067" loading="lazy" />
              <span>{industry.code}</span>
            </figure>
            <div>
              <p class="revamp-eyebrow">Industry pathway</p>
              <h2>{industry.title}</h2>
              <dl>
                <div>
                  <dt>Launch</dt>
                  <dd>{industry.launch}</dd>
                </div>
                <div>
                  <dt>Grow</dt>
                  <dd>{industry.growth}</dd>
                </div>
              </dl>
              <a class="text-link" href={`/contact?type=${industry.id}`}>Discuss this industry <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="revamp-section revamp-section-dark">
    <div class="shell">
      <div class="revamp-heading" data-reveal>
        <div>
          <p class="revamp-eyebrow">Selected proof</p>
          <h2>Strategy built around real operating conditions.</h2>
        </div>
        <p>
          Work has included commercial pathways for companies such as Natridy, Samaria and Ecostar Solar, alongside mandates in construction systems, market entry and infrastructure.
        </p>
      </div>
      <div class="proof-slider" data-reveal>
        <div class="proof-slider-track" style={`--proof-duration:${slideDuration}`}>
          {
            [0, 1].map((pass) =>
              proofPoints.map((point) => (
                <div class="proof-slider-cell" aria-hidden={pass === 1 ? 'true' : undefined}>
                  {
                    point.logo ? (
                      <img
                        class="proof-slider-logo"
                        src={point.logo}
                        alt={point.name}
                        width={point.logoWidth}
                        height={point.logoHeight}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <strong>{point.name}</strong>
                    )
                  }
                  <span>{point.note}</span>
                </div>
              )),
            )
          }
        </div>
      </div>
    </div>
  </section>

  <CTA
    eyebrow="Sector-specific first phase"
    title="Put the market and operating evidence in one view."
    copy="Bring the offer, target market and unresolved constraints. We will define the most useful next commercial decision."
  />
</BaseLayout>

<script is:inline define:vars={{ retiredAnchors }}>
  (function () {
    function remap() {
      var to = retiredAnchors[location.hash.slice(1)];
      if (!to) return;
      var target = document.getElementById(to);
      if (!target) return;
      history.replaceState(null, '', location.pathname + '#' + to);
      target.scrollIntoView();
    }
    remap();
    window.addEventListener('hashchange', remap);
  })();
</script>

<style>
  .industry-feature-grid{display:grid;gap:1rem}
  .industry-feature{display:grid;grid-template-columns:1.05fr .95fr;min-height:600px;background:#fff;border:1px solid var(--line)}
  .industry-feature:nth-child(even){grid-template-columns:.95fr 1.05fr}
  .industry-feature:nth-child(even) figure{order:2}
  .industry-feature figure{position:relative;min-height:500px;margin:0;overflow:hidden;background:var(--black)}
  .industry-feature img{width:100%;height:100%;object-fit:cover;filter:saturate(.55) contrast(1.12)}
  .industry-feature figure span{position:absolute;top:1rem;left:1rem;padding:.5rem .65rem;background:var(--orange);color:var(--black);font-size:.65rem;font-weight:800;letter-spacing:.12em}
  .industry-feature>div{display:flex;flex-direction:column;justify-content:center;padding:clamp(2rem,5vw,5rem)}
  .industry-feature h2{margin:0 0 3rem;font-size:clamp(3rem,5vw,5.8rem)}
  .industry-feature dl{margin:0}
  .industry-feature dl div{display:grid;grid-template-columns:80px 1fr;gap:1rem;padding:1.3rem 0;border-top:1px solid var(--line)}
  .industry-feature dt{color:var(--blue-deep);font-size:.7rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}
  .industry-feature dd{margin:0;color:var(--muted)}
  .industry-feature .text-link{align-self:flex-start;margin-top:2rem}
  /* Continuous slider. The cell set is rendered twice and the track travels
     exactly -50%, so the second pass lands where the first began and the loop
     has no seam. Edge mask softens entry and exit against the section ground. */
  .proof-slider{
    --cell:clamp(250px,26vw,340px);
    overflow:hidden;
    border:2px solid rgba(255,255,255,.2);
    -webkit-mask-image:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent);
    mask-image:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent)
  }
  .proof-slider-track{
    display:flex;
    width:max-content;
    animation:proof-slide var(--proof-duration,38s) linear infinite
  }
  .proof-slider:hover .proof-slider-track,
  .proof-slider:focus-within .proof-slider-track{animation-play-state:paused}
  .proof-slider-cell{
    display:grid;
    align-content:space-between;
    flex:0 0 var(--cell);
    min-height:220px;
    padding:1.7rem;
    border-right:1px solid rgba(255,255,255,.2)
  }
  /* Logos run to a common height rather than a common width, which is what keeps
     marks of different proportions reading at the same optical weight. The
     width/height attributes reserve the box before the bytes arrive, so a lazy
     logo cannot shift the track mid-travel and break the seamless -50% loop. */
  /* Height is responsive because the cell narrows to 250px on small screens, where
     a fixed 58px would push the wider marks past the padding. object-fit guards
     the aspect if max-width ever does clamp the box -- with an explicit height a
     capped width would otherwise squash the artwork. */
  .proof-slider-logo{
    width:auto;
    height:clamp(40px,4.6vw,58px);
    max-width:100%;
    object-fit:contain;
    object-position:left center;
    align-self:start
  }
  .proof-slider-cell strong{
    display:block;
    color:var(--white);
    font-family:var(--sans);
    font-size:clamp(1.75rem,2.7vw,2.9rem);
    font-weight:820;
    letter-spacing:-.06em;
    line-height:.92
  }
  .proof-slider-cell span{
    display:block;
    max-width:18ch;
    margin-top:2.6rem;
    color:rgba(255,255,255,.58);
    font-size:.65rem;
    font-weight:780;
    letter-spacing:.11em;
    text-transform:uppercase
  }
  @keyframes proof-slide{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  /* Reduced motion: hold it still and let the strip be scrolled by hand instead.
     The duplicate pass stays hidden from assistive tech either way. */
  @media(prefers-reduced-motion:reduce){
    .proof-slider{overflow-x:auto;-webkit-mask-image:none;mask-image:none}
    .proof-slider-track{animation:none}
  }
  @media(max-width:800px){.industry-feature,.industry-feature:nth-child(even){min-width:0;grid-template-columns:minmax(0,1fr)}.industry-feature>*{min-width:0}.industry-feature:nth-child(even) figure{order:0}.industry-feature figure{min-height:360px}}
</style>
