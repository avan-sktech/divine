---
import BaseLayout from '../layouts/BaseLayout.astro';
import RevampHero from '../components/RevampHero.astro';
import CTA from '../components/CTA.astro';
import { breadcrumbSchema, sectors, site } from '../data/site';

const title = 'Industries | Commercial Strategy Consultants | DivineLab Worx';
const description =
  'Commercial strategy for retail, manufacturing, sustainable homes, modern construction and critical infrastructure across Australian and international markets.';
const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Industries', path: '/industries' },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Industries served by DivineLab Worx',
    itemListElement: sectors.map((sector, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: sector.title,
      url: `${site.url}${sector.href}`,
    })),
  },
];

const industries = [
  {
    id: 'retail',
    code: 'RTL / 01',
    title: 'Retail',
    launch: 'Enter the market with a defined customer, credible range, compliant claims, channel economics and controlled demand test.',
    growth: 'Use customer behaviour, range performance, supplier leverage and existing channels to improve cross-sell, repeat demand and margin.',
    image: '/images/hero-infrastructure.jpg',
    imageAlt: 'Connected operating systems supporting modern retail',
  },
  {
    id: 'manufacturing',
    code: 'MFG / 02',
    title: 'Manufacturing',
    launch: 'Commercialise equipment, materials or technology with the technical evidence, service model and local channel required in the target market.',
    growth: 'Turn idle capacity, process knowledge, installed relationships and technical capability into adjacent offers and stronger utilisation.',
    image: '/images/manufacturing-automation.jpg',
    imageAlt: 'Industrial automation operating in a modern manufacturing facility',
  },
  {
    id: 'sustainable-homes',
    code: 'BLD / 03',
    title: 'Sustainable and 3D homes',
    launch: 'Align the customer promise, engineering evidence, approvals, supply chain, pilot project and route to repeatable delivery.',
    growth: 'Extend proven build capability into new buyer segments, project types, locations or service layers without losing delivery discipline.',
    image: '/images/construction-night.jpg',
    imageAlt: 'Large construction project representing complex built-environment delivery',
  },
  {
    id: 'infrastructure',
    code: 'INF / 04',
    title: 'Critical infrastructure',
    launch: 'Build the site, stakeholder, utility, planning and commercial evidence required to take a complex proposition toward investment.',
    growth: 'Use existing sites, technical relationships, approvals knowledge and operating capability to create the next defensible infrastructure move.',
    image: '/images/concrete-structure.jpg',
    imageAlt: 'Large concrete infrastructure structure under development',
  },
];
---

<BaseLayout title={title} description={description} schema={schema} pageClass="revamp-page">
  <RevampHero
    eyebrow="Industries"
    title="We work where strategy has to become <em>revenue.</em>"
    support="Commercial pathways for markets where the customer case, approvals, channel and physical delivery have to support each other."
    primaryLabel="Start an engagement"
    primaryHref="/contact"
    secondaryLabel="See capabilities"
    secondaryHref="/capabilities"
    image="/images/manufacturing-automation.jpg"
    imageAlt="Automated manufacturing environment representing complex industry delivery"
    code="IND / INTL"
  />

  <section class="revamp-answer">
    <div class="shell revamp-answer-grid" data-reveal>
      <div>
        <p class="revamp-eyebrow">Direct answer</p>
        <h2>Which industries does DivineLab Worx support?</h2>
      </div>
      <p>
        DivineLab Worx works across retail, manufacturing, sustainable and 3D homes, and critical infrastructure. We support both new-market launch and growth from the assets and relationships already in place.
      </p>
    </div>
  </section>

  <section class="revamp-section">
    <div class="shell">
      <div class="revamp-heading" data-reveal>
        <div>
          <p class="revamp-eyebrow">Industry pathways</p>
          <h2>Sector context. One commercial standard.</h2>
        </div>
        <p>
          Each engagement is grounded in the realities of the industry, while keeping the customer, economics, route and evidence visible.
        </p>
      </div>
      <div class="industry-feature-grid">
        {industries.map((industry) => (
          <article class="industry-feature" id={industry.id} data-reveal>
            <figure>
              <img src={industry.image} alt={industry.imageAlt} width="1600" height="1067" loading="lazy" />
              <span>{industry.code}</span>
            </figure>
            <div>
              <p class="revamp-eyebrow">Industry pathway</p>
              <h2>{industry.title}</h2>
              <dl>
                <div>
                  <dt>Launch</dt>
                  <dd>{industry.launch}</dd>
                </div>
                <div>
                  <dt>Grow</dt>
                  <dd>{industry.growth}</dd>
                </div>
              </dl>
              <a class="text-link" href={`/contact?type=${industry.id}`}>Discuss this industry <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="revamp-section revamp-section-dark">
    <div class="shell">
      <div class="revamp-heading" data-reveal>
        <div>
          <p class="revamp-eyebrow">Selected proof</p>
          <h2>Strategy built around real operating conditions.</h2>
        </div>
        <p>
          Work has included commercial pathways for companies such as Natridy and Samaria, alongside mandates in construction systems, market entry and infrastructure.
        </p>
      </div>
      <div class="proof-strip proof-strip-dark" data-reveal>
        <div><strong>Natridy</strong><span>Commercial and market development</span></div>
        <div><strong>Samaria</strong><span>Strategic growth pathway</span></div>
        <div><strong>INTL</strong><span>Cross-market commercial context</span></div>
        <div><strong>1</strong><span>Accountable route to revenue</span></div>
      </div>
    </div>
  </section>

  <CTA
    eyebrow="Sector-specific first phase"
    title="Put the market and operating evidence in one view."
    copy="Bring the offer, target market and unresolved constraints. We will define the most useful next commercial decision."
  />
</BaseLayout>

<style>
  .industry-feature-grid{display:grid;gap:1rem}
  .industry-feature{display:grid;grid-template-columns:1.05fr .95fr;min-height:600px;background:#fff;border:1px solid var(--line)}
  .industry-feature:nth-child(even){grid-template-columns:.95fr 1.05fr}
  .industry-feature:nth-child(even) figure{order:2}
  .industry-feature figure{position:relative;min-height:500px;margin:0;overflow:hidden;background:var(--black)}
  .industry-feature img{width:100%;height:100%;object-fit:cover;filter:saturate(.55) contrast(1.12)}
  .industry-feature figure span{position:absolute;top:1rem;left:1rem;padding:.5rem .65rem;background:var(--orange);color:var(--black);font-size:.65rem;font-weight:800;letter-spacing:.12em}
  .industry-feature>div{display:flex;flex-direction:column;justify-content:center;padding:clamp(2rem,5vw,5rem)}
  .industry-feature h2{margin:0 0 3rem;font-size:clamp(3rem,5vw,5.8rem)}
  .industry-feature dl{margin:0}
  .industry-feature dl div{display:grid;grid-template-columns:80px 1fr;gap:1rem;padding:1.3rem 0;border-top:1px solid var(--line)}
  .industry-feature dt{color:var(--blue-deep);font-size:.7rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}
  .industry-feature dd{margin:0;color:var(--muted)}
  .industry-feature .text-link{align-self:flex-start;margin-top:2rem}
  .proof-strip-dark{border-color:rgba(255,255,255,.2)}
  .proof-strip-dark>div{border-color:rgba(255,255,255,.2)}
  .proof-strip-dark span{color:rgba(255,255,255,.58)}
  .proof-strip-dark strong{font-size:clamp(2rem,3.2vw,3.6rem)}
  @media(max-width:800px){.industry-feature,.industry-feature:nth-child(even){min-width:0;grid-template-columns:minmax(0,1fr)}.industry-feature>*{min-width:0}.industry-feature:nth-child(even) figure{order:0}.industry-feature figure{min-height:360px}}
</style>
