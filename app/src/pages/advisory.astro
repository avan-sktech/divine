---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import AnswerBlock from '../components/AnswerBlock.astro';
import EditorialMedia from '../components/EditorialMedia.astro';
import FaqList from '../components/FaqList.astro';
import CTA from '../components/CTA.astro';
import {
  advisoryFaqs,
  breadcrumbSchema,
  faqSchema,
  serviceSchema,
} from '../data/site';

const title = 'AI Advisory and Governance Consultants | DivineLab Worx';
const description =
  'AI advisory consulting for organisations across markets: readiness, use-case prioritisation, governance, business cases and implementation pathways.';
const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Capabilities', path: '/capabilities' },
    { name: 'AI advisory', path: '/advisory' },
  ]),
  faqSchema(advisoryFaqs),
  serviceSchema({
    name: 'AI advisory and implementation',
    path: '/advisory',
    serviceType: 'Artificial intelligence advisory',
    description,
    audience: ['Businesses and institutions', 'Boards and executive teams', 'Public sector leaders'],
    offerName: 'AI Opportunity and Readiness Assessment',
  }),
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero
    eyebrow="AI advisory"
    title="AI advisory for value you can <em>govern and measure.</em>"
    lede="Assess readiness, prioritise the right use cases and carry approved opportunities into implementation with accountable controls."
    index="AI / 01"
    secondaryLabel="Our delivery model"
    secondaryHref="/capabilities"
  />
  <AnswerBlock
    question="What does an AI advisory consultant do?"
    answer="An AI advisory consultant identifies where artificial intelligence can create measurable value, assesses organisational readiness, ranks use cases, defines governance and risk controls, builds the business case and plans a controlled implementation pathway."
  />

  <EditorialMedia
    image="/images/editorial/responsible-ai-poster.webp"
    video="/video/editorial/responsible-ai.mp4"
    alt="Robotic hand representing controlled interaction with artificial intelligence"
    eyebrow="Responsible adoption"
    caption="AI creates value when the use case, data, controls, human ownership and measurement method are designed as one operating system."
    index="AI / 02"
    position="center"
  />

  <section class="section section-paper">
    <div class="shell">
      <div class="section-heading" data-reveal>
        <p class="eyebrow">The advisory pathway</p>
        <h2>From a portfolio of ideas to a funded priority.</h2>
        <p>The work is designed to answer the decisions a board, executive sponsor and delivery owner actually need to make.</p>
      </div>
      <div class="index-list" data-reveal>
        <article class="index-row"><span class="index-number">01</span><h3>Opportunity portfolio</h3><p>Identify operating constraints and rank use cases against value, feasibility, data readiness, risk and time to evidence.</p><span class="index-arrow">+</span></article>
        <article class="index-row"><span class="index-number">02</span><h3>Business case and controls</h3><p>Define the baseline, expected benefit, adoption requirements, model risk, governance and measurement method.</p><span class="index-arrow">+</span></article>
        <article class="index-row"><span class="index-number">03</span><h3>Solution pathway</h3><p>Translate the selected use case into workflow design, data dependencies, integration, operating ownership and delivery stages.</p><span class="index-arrow">+</span></article>
        <article class="index-row"><span class="index-number">04</span><h3>Contained implementation</h3><p>Build and deploy a functional system, observe evidence in the real workflow and define the next scale decision.</p><span class="index-arrow">+</span></article>
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="shell split-grid">
      <div data-reveal>
        <p class="eyebrow eyebrow-light">Public sector and policy</p>
        <h2>Evidence for decisions that affect more than one organisation.</h2>
        <p style="color:rgba(255,255,255,.62)" class="prose-large">
          AI policy and public-sector programmes need transparent assumptions, stakeholder participation, defensible benefits and clear safeguards. We structure the evidence so that public value, economic outcomes and implementation constraints can be considered together.
        </p>
        <p style="color:rgba(255,255,255,.62)">
          For Australian engagements, the approach reflects the Australian Government's practical foundations for responsible AI: accountability, impact assessment, risk management, transparency, testing and meaningful human control. Other markets are assessed against their own legal, policy and institutional context. <a class="text-link text-link-light" href="https://www.ai.gov.au/staying-safe-and-responsible/essential-ai-practices/guidance-ai-adoption-foundations">Read the National AI Centre guidance</a>.
        </p>
      </div>
      <div class="principle-list principle-list-dark" data-reveal>
        <div class="principle"><strong>01</strong><div><h3>Policy and economic analysis</h3><p>Outcomes, affected groups, implementation levers and measurable public value.</p></div></div>
        <div class="principle"><strong>02</strong><div><h3>Responsible AI controls</h3><p>Governance, transparency, human oversight, privacy and risk appropriate to the use case.</p></div></div>
        <div class="principle"><strong>03</strong><div><h3>Stakeholder evidence</h3><p>Structured inputs that make competing needs and confidence levels visible.</p></div></div>
      </div>
    </div>
  </section>

  <FaqList items={advisoryFaqs} heading="AI advisory, made clear." />
  <CTA
    eyebrow="AI opportunity assessment"
    title="Find the use cases worth funding."
    copy="Begin with a contained assessment of value, feasibility, data readiness, risk and time to evidence."
    href="/contact?type=ai-advisory"
  />
</BaseLayout>

<style>
  .principle-list-dark { border-color:var(--line-light); }
  .principle-list-dark .principle { border-color:var(--line-light); }
  .principle-list-dark p { color:rgba(255,255,255,.58); }
  .principle-list-dark strong { color:#9eb2ff; }
</style>
