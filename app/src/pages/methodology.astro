---
import BaseLayout from '../layouts/BaseLayout.astro';
import RevampHero from '../components/RevampHero.astro';
import MethodologyCarousel from '../components/MethodologyCarousel.astro';
import FaqList from '../components/FaqList.astro';
import CTA from '../components/CTA.astro';
import {
  breadcrumbSchema,
  faqSchema,
  insights,
  serviceSchema,
  site,
} from '../data/site';

const title = 'Concurrent Product and Process Design Methodology | DivineLab Worx';
const description =
  'Explore the DivineLab Worx evidence-led business strategy methodology for market entry, product commercialisation, transformation, AI and capital-efficient growth.';

const methodologyFaqs = [
  {
    question: 'What is the DivineLab Concurrent Method?',
    answer:
      'The DivineLab Concurrent Method is an evidence-led business strategy methodology that develops the proposition, delivery system, commercial economics, assurance and market evidence together. It applies concurrent product and process design principles to market entry, product commercialisation, business transformation, critical infrastructure and applied AI.',
  },
  {
    question: 'What is Concurrent Product and Process Design?',
    answer:
      'Concurrent Product and Process Design develops what an organisation will offer and how it will produce, deliver, support and improve that offer at the same time. The method exposes dependencies early, before cost, compliance risk and operating complexity become difficult to reverse.',
  },
  {
    question: 'How is DivineLab Worx different from a traditional strategy consultancy?',
    answer:
      'Traditional strategy consulting can separate the recommendation from implementation. DivineLab Worx connects market evidence, operating design, technology, delivery ownership and investment gates from the beginning, so the strategy is tested against the conditions required to execute it.',
  },
  {
    question: 'When should an organisation use the methodology?',
    answer:
      'Use the methodology when entering a new market, commercialising a product, redesigning an operating model, evaluating infrastructure, selecting an AI use case or making a complex investment decision with multiple interdependent workstreams.',
  },
  {
    question: 'What is an evidence gate?',
    answer:
      'An evidence gate is a decision point that specifies what must be known, tested or verified before more capital, inventory, technology or organisational effort is released. It makes assumptions, ownership and residual risk visible to decision-makers.',
  },
  {
    question: 'Can the methodology support international market strategy?',
    answer:
      'Yes. The method separates the core commercial logic from the legal, cultural, channel and operating conditions of each market. This allows international organisations to adapt the offer and delivery system without losing strategic consistency.',
  },
];

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How the DivineLab Concurrent Method turns strategy into implementation',
  description:
    'A six-stage business strategy and implementation methodology based on concurrent product and process design.',
  url: `${site.url}/methodology`,
  author: { '@id': `${site.url}/#organisation` },
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Frame the decision',
      text: 'Define the customer, market or operating outcome and the investment decision the work must support.',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Establish the evidence baseline',
      text: 'Separate verified facts, tested evidence, assumptions and unresolved dependencies.',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Set measurable criteria',
      text: 'Translate the mandate into customer, commercial, technical, assurance and operating requirements.',
    },
    {
      '@type': 'HowToStep',
      position: 4,
      name: 'Design the proposition and delivery system together',
      text: 'Develop the offer, route to market, operating process, technology, economics and ownership in parallel.',
    },
    {
      '@type': 'HowToStep',
      position: 5,
      name: 'Verify before commitment',
      text: 'Use prototypes, pilots and evidence gates to test value, feasibility, risk and delivery readiness.',
    },
    {
      '@type': 'HowToStep',
      position: 6,
      name: 'Scale through field learning',
      text: 'Release the next investment stage only when results support repeatable delivery and continued improvement.',
    },
  ],
};

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Methodology', path: '/methodology' },
  ]),
  faqSchema(methodologyFaqs),
  howToSchema,
  serviceSchema({
    name: 'Concurrent strategy and delivery methodology',
    path: '/methodology',
    serviceType: [
      'Concurrent Product and Process Design consulting',
      'Business strategy methodology',
      'Strategy implementation consulting',
      'Product commercialisation consulting',
    ],
    description,
    audience: [
      'Boards and executive teams',
      'International market entrants',
      'Manufacturers and product businesses',
      'Infrastructure investors and operators',
    ],
    offerName: 'Concurrent Method Diagnostic',
  }),
];

const applications = [
  {
    number: '01',
    title: 'International market entry strategy',
    copy: 'Market choice, customer offer, channel, delivery readiness and economics mature around one entry decision.',
    href: '/market-entry-australia',
  },
  {
    number: '02',
    title: 'Product commercialisation consulting',
    copy: 'Customer requirements, product design, production, assurance and service become one commercial system.',
    href: '/product-commercialisation',
  },
  {
    number: '03',
    title: 'Business transformation strategy',
    copy: 'Executive intent, stakeholders, operations, technology and investment gates move through a shared evidence plan.',
    href: '/work',
  },
  {
    number: '04',
    title: 'Critical infrastructure feasibility',
    copy: 'Site intelligence, utilities, delivery sequencing, assurance and operations are tested before major commitment.',
    href: '/infrastructure',
  },
  {
    number: '05',
    title: 'AI advisory and governance',
    copy: 'Value, workflow, data, controls and adoption develop together around a measurable operating use case.',
    href: '/advisory',
  },
];
---

<BaseLayout title={title} description={description} schema={schema} pageClass="revamp-page">
  <RevampHero
    eyebrow="The DivineLab Concurrent Method"
    title="Strategy, delivery and evidence <em>designed together.</em>"
    support="An evidence-led business strategy methodology for market entry, commercialisation, transformation, infrastructure and applied AI."
    primaryLabel="Explore the method"
    primaryHref="#method-system"
    secondaryLabel="Read our insights"
    secondaryHref="/blog"
    video="/video/editorial/digital-business-systems.mp4"
    image="/images/editorial/digital-business-systems-poster.webp"
    imageAlt="Connected digital system representing concurrent commercial decision-making"
    code="MTH / INTL"
  />

  <section class="revamp-answer">
    <div class="shell revamp-answer-grid" data-reveal>
      <div>
        <p class="revamp-eyebrow">Direct answer</p>
        <h2>What makes DivineLab Worx different?</h2>
      </div>
      <p>
        We do not separate strategy from the system required to deliver it. Market evidence,
        the offer, operating process, technology, economics and assurance mature together,
        with evidence controlling each major commitment.
      </p>
    </div>
  </section>

  <section class="revamp-section">
    <div class="shell">
      <div class="revamp-heading" data-reveal>
        <div>
          <p class="revamp-eyebrow">01 / The advantage</p>
          <h2>Designed to survive contact with reality.</h2>
        </div>
        <p>
          The method keeps the commercial promise and the delivery system connected while
          change is still affordable.
        </p>
      </div>
      <div class="method-principles" data-reveal>
        <article><span>01</span><h3>Concurrent by design</h3><p>Interdependent decisions mature together.</p></article>
        <article><span>02</span><h3>Evidence before commitment</h3><p>Every gate names the proof required to proceed.</p></article>
        <article><span>03</span><h3>Commercial and operating fit</h3><p>The offer must work for the buyer and the delivery system.</p></article>
        <article><span>04</span><h3>Learning remains open</h3><p>Field evidence guides the next investment decision.</p></article>
      </div>
    </div>
  </section>

  <section class="method-system" id="method-system">
    <MethodologyCarousel />
  </section>

  <section class="revamp-section">
    <div class="shell">
      <div class="revamp-heading" data-reveal>
        <div>
          <p class="revamp-eyebrow">03 / Where it applies</p>
          <h2>One decision system. Different operating realities.</h2>
        </div>
        <p>
          The workstreams change with the mandate, but evidence, ownership and commercial
          line of sight remain constant.
        </p>
      </div>
      <div class="method-applications">
        {applications.map((item) => (
          <article data-reveal>
            <span>{item.number}</span>
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
            <a href={item.href}>Explore application <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="revamp-section revamp-section-dark">
    <div class="shell">
      <div class="revamp-heading" data-reveal>
        <div>
          <p class="revamp-eyebrow">04 / Decision discipline</p>
          <h2>What changes when decisions are concurrent?</h2>
        </div>
        <p>
          Strategy implementation becomes a controlled progression of evidence, rather than
          a handover between disconnected teams.
        </p>
      </div>
      <div class="method-comparison" data-reveal>
        <div><span>Sequential approach</span><strong>Recommendation first</strong><p>Delivery constraints surface after approval.</p></div>
        <div><span>Concurrent method</span><strong>Recommendation and delivery fit</strong><p>Operating reality shapes the strategy from the beginning.</p></div>
        <div><span>Sequential approach</span><strong>Pilot as demonstration</strong><p>Activity is mistaken for commercial evidence.</p></div>
        <div><span>Concurrent method</span><strong>Pilot as decision gate</strong><p>Measured results control the next commitment.</p></div>
      </div>
    </div>
  </section>

  <section class="revamp-section">
    <div class="shell method-foundation">
      <div data-reveal>
        <p class="revamp-eyebrow">Research foundation</p>
        <h2>Established engineering discipline. Broader commercial application.</h2>
      </div>
      <div data-reveal>
        <p>
          Concurrent engineering integrates product development with the design and
          production processes required to deliver it. DivineLab Worx extends that logic
          into market strategy, commercial operations, transformation and investment decisions.
        </p>
        <div class="method-sources">
          <a href="https://www.cirp.net/component/cirppubli/?task=searchkeynote&year=1992" target="_blank" rel="noopener">
            <span>Primary source</span>
            CIRP Annals: Concurrent Engineering, 1992
          </a>
          <a href="https://www.handbook.unsw.edu.au/undergraduate/courses/2026/MANF4150" target="_blank" rel="noopener">
            <span>Academic context</span>
            UNSW: Concurrent Engineering of Smart Product and Manufacturing Systems
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="revamp-section method-insights">
    <div class="shell">
      <div class="revamp-heading" data-reveal>
        <div>
          <p class="revamp-eyebrow">Continue the thinking</p>
          <h2>Methodology applied to real commercial decisions.</h2>
        </div>
        <p>
          Read practical perspectives on market entry, product design, growth and
          infrastructure decision-making.
        </p>
      </div>
      <div class="method-insight-grid">
        {insights.slice(0, 3).map((item, index) => (
          <article data-reveal>
            <span>{String(index + 1).padStart(2, '0')} / {item.category}</span>
            <h3>{item.title}</h3>
            <a href={`/blog/${item.slug}`}>Read insight <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
      <a class="method-all-insights" href="/blog">View all DivineLab Worx insights <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <FaqList items={methodologyFaqs} heading="The methodology, made clear." />
  <CTA
    eyebrow="Concurrent Method Diagnostic"
    title="Put the decision and its delivery system on the same page."
    copy="Start with a contained diagnostic that identifies the workstreams, evidence gaps, dependencies and next safe commitment."
    href="/contact?type=methodology"
  />
</BaseLayout>

<style>
  .method-principles{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid var(--line);border-left:1px solid var(--line)}
  .method-principles article{min-height:300px;padding:1.8rem;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}
  .method-principles span{color:var(--blue-deep);font-size:.68rem;font-weight:820;letter-spacing:.13em}
  .method-principles h3{margin:6rem 0 .8rem;font-family:var(--display);font-size:clamp(1.7rem,2.6vw,2.7rem);font-weight:470;line-height:.98}
  .method-principles p{margin:0;color:var(--muted);font-size:.9rem}
  .method-system{padding-block:clamp(6rem,10vw,10rem);background:var(--black)}
  .method-applications{border-top:2px solid var(--black)}
  .method-applications article{display:grid;grid-template-columns:65px 1fr 1.1fr auto;gap:clamp(1rem,3vw,3rem);align-items:start;padding-block:2rem;border-bottom:1px solid var(--line)}
  .method-applications article>span{color:var(--blue-deep);font-size:.68rem;font-weight:820}
  .method-applications h3{margin:0;font-size:clamp(1.2rem,2vw,1.8rem)}
  .method-applications p{max-width:560px;margin:0;color:var(--muted)}
  .method-applications a,.method-insight-grid a,.method-all-insights{color:var(--blue-deep);font-size:.68rem;font-weight:780;letter-spacing:.09em;text-transform:uppercase}
  .method-comparison{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-top:1px solid rgba(255,255,255,.2);border-left:1px solid rgba(255,255,255,.2)}
  .method-comparison>div{min-height:250px;padding:2rem;border-right:1px solid rgba(255,255,255,.2);border-bottom:1px solid rgba(255,255,255,.2)}
  .method-comparison span{color:#9eb2ff;font-size:.65rem;font-weight:820;letter-spacing:.12em;text-transform:uppercase}
  .method-comparison strong{display:block;max-width:18ch;margin:4rem 0 .7rem;color:var(--white);font-family:var(--display);font-size:clamp(1.7rem,3vw,3.1rem);font-weight:470;line-height:.96}
  .method-comparison p{max-width:48ch;margin:0;color:rgba(255,255,255,.56)}
  .method-foundation{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(3rem,8vw,8rem)}
  .method-foundation h2{max-width:12ch;margin:0;font-family:var(--display);font-size:clamp(3rem,5vw,5.4rem);font-weight:470;letter-spacing:-.045em;line-height:.92}
  .method-foundation>div:last-child>p{max-width:720px;margin:0;color:var(--muted);font-size:1.08rem;line-height:1.75}
  .method-sources{margin-top:2.5rem;border-top:1px solid var(--line)}
  .method-sources a{display:grid;grid-template-columns:150px 1fr;gap:1.5rem;padding:1.2rem 0;border-bottom:1px solid var(--line);color:var(--black);font-weight:700}
  .method-sources span{color:var(--blue-deep);font-size:.65rem;letter-spacing:.1em;text-transform:uppercase}
  .method-insights{background:var(--paper-2)}
  .method-insight-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:var(--line)}
  .method-insight-grid article{min-height:320px;display:flex;flex-direction:column;align-items:flex-start;padding:2rem;background:var(--paper)}
  .method-insight-grid article>span{color:var(--blue-deep);font-size:.65rem;font-weight:820;letter-spacing:.1em;text-transform:uppercase}
  .method-insight-grid h3{max-width:16ch;margin:auto 0 1.4rem;font-family:var(--display);font-size:clamp(1.7rem,2.7vw,2.8rem);font-weight:470;line-height:.98}
  .method-all-insights{display:inline-flex;margin-top:2rem}
  @media(max-width:920px){.method-principles{grid-template-columns:repeat(2,minmax(0,1fr))}.method-applications article{grid-template-columns:45px 1fr}.method-applications p,.method-applications a{grid-column:2}.method-foundation{grid-template-columns:1fr}.method-insight-grid{grid-template-columns:1fr}}
  @media(max-width:620px){.method-principles,.method-comparison{grid-template-columns:1fr}.method-principles article{min-height:240px}.method-principles h3{margin-top:4rem}.method-sources a{grid-template-columns:1fr;gap:.4rem}}
</style>
