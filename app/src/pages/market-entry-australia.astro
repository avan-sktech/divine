---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceLanding from '../components/ServiceLanding.astro';
import {
  breadcrumbSchema,
  faqSchema,
  marketEntryFaqs,
  serviceSchema,
} from '../data/site';

const title = 'Australian Market Entry Consulting | DivineLab Worx';
const description =
  'Australian market entry strategy for overseas and expanding businesses. Validate demand, map requirements, design channels and stage investment before launch.';
const path = '/market-entry-australia';
const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Capabilities', path: '/capabilities' },
    { name: 'Australian market entry', path },
  ]),
  faqSchema(marketEntryFaqs),
  serviceSchema({
    name: 'Australian Market Entry Consulting',
    path,
    description,
    serviceType: [
      'Australian market entry strategy',
      'Market validation',
      'Regulatory pathway mapping',
      'Route-to-market design',
    ],
    audience: ['International businesses entering Australia', 'Businesses expanding into a new Australian market'],
    offerName: 'Australian Market Entry Assessment',
    areaServed: { '@type': 'Country', name: 'Australia' },
  }),
];

const audienceItems = [
  {
    title: 'International product companies',
    copy: 'You have a proven offer elsewhere and need to determine what must change for Australian customers, standards and channels.',
  },
  {
    title: 'Manufacturers and technology providers',
    copy: 'Local demand may be attractive, but evidence, service, distribution and compliance have to be designed together.',
  },
  {
    title: 'Established businesses entering a new sector',
    copy: 'Your capabilities are credible, but the buying group, tender pathway and route to first revenue are different.',
  },
  {
    title: 'Boards testing an entry thesis',
    copy: 'A defensible evidence base is required before committing inventory, people, partnerships or establishment costs.',
  },
];

const scopeItems = [
  {
    title: 'Market attractiveness',
    copy: 'Assess demand, category structure, growth drivers, alternatives, market access and the segments that merit deeper testing.',
  },
  {
    title: 'Customer validation',
    copy: 'Identify the first viable customer, buying criteria, decision-makers, objections and the evidence required to win confidence.',
  },
  {
    title: 'Competitive position',
    copy: 'Compare local offers, substitutes, price logic, claims, service expectations and the whitespace the proposition can credibly own.',
  },
  {
    title: 'Regulatory pathway',
    copy: 'Map standards, registrations, certifications, claims and specialist advice into the commercial programme before launch commitments.',
  },
  {
    title: 'Channel and local delivery',
    copy: 'Design partner roles, margins, fulfilment, installation, support and local operating ownership around the buying journey.',
  },
  {
    title: 'Pilot and investment gates',
    copy: 'Define a contained first market test, success measures and the evidence that determines whether to stop, adapt or scale.',
  },
];

const processItems = [
  {
    number: '01',
    title: 'Set the Australian entry mandate',
    copy: 'Clarify the commercial objective, risk tolerance, timing, target return and decisions that need local evidence.',
  },
  {
    number: '02',
    title: 'Build the market evidence',
    copy: 'Test customers, competitors, price, requirements, channels and delivery assumptions against current Australian conditions.',
  },
  {
    number: '03',
    title: 'Design the entry pathway',
    copy: 'Connect market position, compliance, partners, operations, launch activity, ownership and capital into one staged plan.',
  },
  {
    number: '04',
    title: 'Prove the first revenue case',
    copy: 'Use a pilot customer, channel test or controlled release to improve confidence before wider establishment and scale.',
  },
];

const comparisonItems = [
  {
    question: 'Market research',
    weak: 'A national market size with limited evidence about who will buy first.',
    strong: 'A beachhead customer, buying trigger, decision group and testable demand case.',
  },
  {
    question: 'Compliance',
    weak: 'A technical task left until the product and launch plan are fixed.',
    strong: 'A commercial workstream linked to claims, timing, inventory, partners and cost.',
  },
  {
    question: 'Local partner',
    weak: 'Appoint a distributor and transfer responsibility for market creation.',
    strong: 'Define partner role, incentive, enablement, service ownership and productive coverage.',
  },
  {
    question: 'Investment',
    weak: 'Commit the full launch budget before local conversion evidence exists.',
    strong: 'Release resources in stages as customer, channel and operating evidence improves.',
  },
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <ServiceLanding
    eyebrow="Australian market entry consulting"
    title="Enter Australia with evidence, not <em>assumptions.</em>"
    lede="Validate the first customer, map the local requirements and prove a route to revenue before committing heavily to market entry."
    index="ENT / AU"
    answerQuestion="How should a business enter the Australian market?"
    answer="A business should enter Australia through a staged market entry strategy that validates the first customer, tests the commercial model, maps regulatory and delivery requirements, selects the right route to market and builds local revenue evidence before broader investment."
    audienceHeading="Built for businesses that need more than a market report."
    audienceCopy="The service connects market insight to the compliance, channel, operating and investment decisions required to produce revenue in Australia."
    audienceItems={audienceItems}
    scopeHeading="The Australian entry case in one view."
    scopeCopy="Market, regulatory and delivery evidence is developed together so the launch plan remains commercially coherent."
    scopeItems={scopeItems}
    processHeading="Reduce uncertainty before increasing commitment."
    processCopy="Each stage is designed to resolve a material question and protect the next use of inventory, capital or leadership attention."
    processItems={processItems}
    comparisonHeading="A practical market entry strategy is staged."
    comparisonCopy="The strongest pathway replaces broad confidence with specific customer, compliance, channel and operating evidence."
    comparisonItems={comparisonItems}
    faqs={marketEntryFaqs}
    faqHeading="Australian market entry consulting, answered."
    ctaEyebrow="Australian market entry assessment"
    ctaTitle="Test the entry thesis before funding the launch."
    ctaCopy="Define the first customer, local requirements, route to market, pilot and evidence gates in a contained initial engagement."
    ctaLabel="Request a market entry assessment"
    ctaHref="/contact?type=market-entry"
    secondaryLabel="Go-to-market strategy"
    secondaryHref="/go-to-market-strategy"
  />
</BaseLayout>
