---
import BaseLayout from '../layouts/BaseLayout.astro';
import RevampHero from '../components/RevampHero.astro';
import { breadcrumbSchema, site } from '../data/site';

const title = 'Contact DivineLab Worx Strategy Consultants';
const description =
  'Discuss international strategy, transformation, market entry, go-to-market, channel design, commercialisation, AI advisory or growth with DivineLab Worx.';
---

<BaseLayout
  title={title}
  description={description}
  schema={breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact' }])}
  pageClass="revamp-page"
>
  <RevampHero
    eyebrow="Contact"
    title="Start an <em>engagement.</em>"
    support="Tell us where you are and what the decision is."
    primaryLabel="Email us directly"
    primaryHref={`mailto:${site.email}`}
    secondaryLabel="Call us"
    secondaryHref={`tel:${site.phone}`}
    code="ENG / INTL"
  />

  <section class="revamp-answer">
    <div class="shell revamp-answer-grid" data-reveal>
      <div>
        <p class="revamp-eyebrow">What happens next</p>
        <h2>Start with the decision.</h2>
      </div>
      <p>
        Share the commercial outcome, what is already known and where the uncertainty sits. We will respond with the most useful next conversation or contained first phase.
      </p>
    </div>
  </section>

  <section class="revamp-section">
    <div class="shell contact-grid">
      <div data-reveal>
        <p class="revamp-eyebrow">Direct contact</p>
        <h2>Speak with our strategy team.</h2>
        <p class="prose-large">
          Include the target outcome, market, timing and the decision or approval currently in view. A polished brief is not required.
        </p>
        <div class="contact-details">
          <div class="contact-line"><span>Email</span><a href={`mailto:${site.email}`}>{site.email}</a></div>
          <div class="contact-line"><span>Phone</span><a href={`tel:${site.phone}`}>{site.phoneDisplay}</a></div>
          <div class="contact-line"><span>Office</span><span>{site.address}</span></div>
          <div class="contact-line"><span>ABN</span><span>{site.abn}</span></div>
        </div>
      </div>

      <div class="contact-form-embed" data-reveal>
        <iframe
          src="https://ghllinks.sharktech.com.au/widget/form/IlR1NFfnUvT1ZjzbF9jB"
          style="width:100%;height:100%;border:none;border-radius:8px"
          id="inline-IlR1NFfnUvT1ZjzbF9jB"
          data-layout="{'id':'INLINE'}"
          data-trigger-type="alwaysShow"
          data-trigger-value=""
          data-activation-type="alwaysActivated"
          data-activation-value=""
          data-deactivation-type="neverDeactivate"
          data-deactivation-value=""
          data-form-name="divinelabworx form"
          data-height="853"
          data-layout-iframe-id="inline-IlR1NFfnUvT1ZjzbF9jB"
          data-form-id="IlR1NFfnUvT1ZjzbF9jB"
          title="divinelabworx form"
        >
        </iframe>
        <script is:inline src="https://ghllinks.sharktech.com.au/js/form_embed.js"></script>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-form-embed iframe{min-height:853px}
  .contact-grid>div h2{font-family:var(--display);font-size:clamp(3rem,5vw,5.8rem);font-weight:470;letter-spacing:-.045em;line-height:.92;text-transform:none}
</style>
