---
import BaseLayout from '../layouts/BaseLayout.astro';
import RevampHero from '../components/RevampHero.astro';
import StrategyFilmstrip from '../components/StrategyFilmstrip.astro';
import FaqList from '../components/FaqList.astro';
import CTA from '../components/CTA.astro';
import { faqSchema, homeFaqs, process, sectors, services } from '../data/site';

const title = 'Business Strategy and Transformation Consultants | DivineLab Worx';
const description =
  'Business strategy, market entry and transformation consultants for organisations entering markets, launching offers and governing complex growth decisions.';

const homeCapabilities = services.map((service, index) => ({
  ...service,
  brief: [
    'Choose the first market, customer and proof point.',
    'Bring approval requirements into the commercial plan early.',
    'Build a route to market that works for every participant.',
    'Design the offer and the operating process together.',
    'Turn positioning into measurable demand and conversion.',
    'Find new revenue inside the capacity already funded.',
    'Prioritise valuable use cases with accountable controls.',
    'Move complex mandates through evidence and investment gates.',
  ][index],
  image: [
    '/images/editorial/chess-opening-poster.webp',
    '',
    '/images/editorial/executive-workshop.webp',
    '',
    '/images/editorial/marketing-operations.webp',
    '',
    '/images/editorial/digital-business-systems-poster.webp',
    '/images/editorial/chess-executive-poster.webp',
  ][index],
  video: index === 6 ? '/video/editorial/digital-business-systems.mp4' : '',
}));

/* These two arrays are indexed against `sectors`, and both were written before
   Retail was added at the top of that list -- so every entry had slid one position
   out of step. Retail was showing the factory floor, Manufacturing the building
   site, Construction the server racks, and Critical infrastructure a meeting room.
   The briefs were shifted identically: "Connect site, power, planning and
   investment decisions" is infrastructure language and was sitting on Construction.
   Keep these aligned with `sectors` in site.ts if a vertical is ever added again. */
const sectorImages = [
  '/images/editorial/commercial-analysis.webp', // Retail
  '/images/manufacturing-automation.jpg', // Manufacturing
  '/images/construction-night.jpg', // Construction
  '/images/hero-infrastructure.jpg', // Critical infrastructure
];

const sectorBriefs = [
  'Launch new ranges and improve channel economics.',
  'Commercialise complex products and operating systems.',
  'Align approvals, delivery evidence and repeatable economics.',
  'Connect site, power, planning and investment decisions.',
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/"
  schema={faqSchema(homeFaqs)}
  pageClass="revamp-page"
>
  <RevampHero
    eyebrow="Business strategy and transformation consultancy"
    title="Business strategy that turns into <em>market action.</em>"
    support="Enter a new market, launch an offer, evaluate a transformation or grow from existing capacity with one accountable strategy and delivery team."
    primaryLabel="Start an engagement"
    primaryHref="/contact"
    secondaryLabel="See capabilities"
    secondaryHref="/capabilities"
    video="/video/divinelab-hero-background.mp4?v=international-markets"
    image="/images/hero-infrastructure.jpg"
    imageAlt="Technical infrastructure representing complex commercial strategy and delivery"
    code="DLW / International / 2026"
  />

  <section class="revamp-answer">
    <div class="shell revamp-answer-grid" data-reveal>
      <div>
        <p class="revamp-eyebrow">Direct answer</p>
        <h2>What does a business strategy and transformation consultant do?</h2>
      </div>
      <p>
        DivineLab Worx turns a complex growth decision into market evidence, clear choices and accountable action across Australia and international markets.
      </p>
    </div>
  </section>

  <StrategyFilmstrip />

  <section class="methodology-bridge">
    <div class="shell methodology-bridge-grid">
      <div data-reveal>
        <p class="revamp-eyebrow">The DivineLab Concurrent Method</p>
        <h2>Strategy and delivery designed as one system.</h2>
        <p>
          Five workstreams mature together. Evidence controls when the next
          commercial commitment is safe to make.
        </p>
        <a class="text-link" href="/methodology">Explore our methodology <span aria-hidden="true">↗</span></a>
      </div>
      <div class="methodology-map" aria-label="Five concurrent workstreams across six evidence gates" data-reveal>
        {['Market', 'Offer', 'Delivery', 'Economics', 'Evidence'].map((track) => (
          <div>
            <span>{track}</span>
            <i></i><i></i><i></i><i></i><i></i><i></i>
          </div>
        ))}
        <p>Frame <span>→</span> Criteria <span>→</span> Design <span>→</span> Integrate <span>→</span> Verify <span>→</span> Learn</p>
      </div>
    </div>
  </section>

  <section class="revamp-section">
    <div class="shell">
      <div class="revamp-heading" data-reveal>
        <div>
          <p class="revamp-eyebrow">Two paths to revenue</p>
          <h2>Build the new. Unlock the existing.</h2>
        </div>
        <p>
          Different growth problems need different starting points. Both paths end with a clear customer, a credible route to market and measurable commercial evidence.
        </p>
      </div>
      <div class="path-grid" data-reveal>
        <article class="path-card">
          <span class="path-card-number">PATH / 01</span>
          <figure class="path-card-media">
            <img src="/images/editorial/commercial-analysis.webp" alt="Commercial evidence under review before a new market decision" width="1600" height="900" loading="lazy" decoding="async" />
          </figure>
          <h3>Launch something new.</h3>
          <p>
            Define the customer, commercial model and proof required before a major launch commitment.
          </p>
          <a class="text-link text-link-light" href="/capabilities">Explore launch capability <span aria-hidden="true">↗</span></a>
        </article>
        <article class="path-card">
          <span class="path-card-number">PATH / 02</span>
          <figure class="path-card-media">
            <img src="/images/editorial/team-collaboration.webp" alt="Business team identifying growth opportunities within existing capacity" width="1600" height="900" loading="lazy" decoding="async" />
          </figure>
          <h3>Grow what already works.</h3>
          <p>
            Turn existing customers, assets, channels and capabilities into the next revenue move.
          </p>
          <a class="text-link" href="/capabilities/capital-efficient-growth">Explore capital-efficient growth <span aria-hidden="true">↗</span></a>
        </article>
      </div>
    </div>
  </section>

  <section class="revamp-section revamp-section-dark">
    <div class="shell">
      <div class="revamp-heading" data-reveal>
        <div>
          <p class="revamp-eyebrow">Complete capability</p>
          <h2>Eight moves. One commercial system.</h2>
        </div>
        <p>
          Start with one decision. Keep the whole route to market in view.
        </p>
      </div>
      <div class="capability-mosaic" data-reveal>
        {homeCapabilities.map((service) => (
          <article class:list={['capability-tile', { 'capability-tile-media': service.image }]}>
            {service.image && <img src={service.image} alt="" width="1200" height="900" loading="lazy" decoding="async" />}
            {service.video && (
              <video muted loop playsinline preload="none" poster={service.image} aria-hidden="true" tabindex="-1" data-editorial-video>
                <source src={service.video} type="video/mp4" />
              </video>
            )}
            <span class="capability-tile-wash" aria-hidden="true"></span>
            <div class="capability-tile-copy">
              <span>{service.number}</span>
              <h3>{service.title}</h3>
              <p>{service.brief}</p>
              <a href={service.href} aria-label={`Explore ${service.title}`}>View capability <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="revamp-section">
    <div class="shell">
      <div class="revamp-heading" data-reveal>
        <div>
          <p class="revamp-eyebrow">Where we work</p>
          <h2>Markets where execution matters.</h2>
        </div>
        <p>
          We work where regulation, physical delivery, channel design and buyer confidence have to move together.
        </p>
      </div>
      <div class="sector-grid sector-grid-visual" data-reveal>
        {sectors.map((sector, index) => (
          <article class="sector-card">
            <figure class="sector-card-media">
              <img src={sectorImages[index]} alt="" width="1200" height="800" loading="lazy" decoding="async" />
            </figure>
            <span class="sector-code">{sector.code} / INTL</span>
            <h3>{sector.title}</h3>
            <p>{sectorBriefs[index]}</p>
            <a class="text-link" href={sector.href}>Explore industry <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="revamp-section revamp-section-dark">
    <div class="shell">
      <div class="revamp-heading" data-reveal>
        <div>
          <p class="revamp-eyebrow">Governed by evidence</p>
          <h2>Every move answers four questions.</h2>
        </div>
        <p>
          This keeps decisions close to the customer and makes progress visible before more capital or effort is released.
        </p>
      </div>
      <div class="governance-grid" data-reveal>
        {process.map((item) => (
          <article class="governance-card">
            <span>{item.number}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="revamp-section">
    <div class="shell">
      <div class="revamp-heading" data-reveal>
        <div>
          <p class="revamp-eyebrow">Credibility in the room</p>
          <h2>Independent thinking. Delivery connected.</h2>
        </div>
        <p>
          DivineLab Worx is the consultancy division of Sharktech Global, led by strategist Dainu Devis and informed by expert work through the Guidepoint network.
        </p>
      </div>
      <div class="proof-strip" data-reveal>
        <div><strong>DLW</strong><span>Strategy and commercial direction</span></div>
        <div><strong>STG</strong><span>Technology and delivery capability</span></div>
        <div><strong>INTL</strong><span>Cross-market decision support</span></div>
        <div><strong>1</strong><span>Accountable engagement</span></div>
      </div>
    </div>
  </section>

  <FaqList items={homeFaqs} />
  <CTA
    eyebrow="Start with the decision"
    title="Launch the new or unlock the growth already there."
    copy="Tell us where the business is now, what has to change and which commercial decision is next."
  />
</BaseLayout>
