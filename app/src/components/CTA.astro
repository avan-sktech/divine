---
interface Props {
  eyebrow?: string;
  title?: string;
  copy?: string;
  label?: string;
  href?: string;
}
const {
  eyebrow = 'A contained first phase',
  title = 'Turn the mandate into a decision-ready pathway.',
  copy = 'Bring the outcome, the constraints and the unresolved questions. We will structure the evidence and define the next investment gate.',
  label = 'Start a conversation',
  href = '/contact',
} = Astro.props;
---

<section class="cta-section">
  <div class="cta-field" aria-hidden="true"></div>
  <div class="shell cta-grid" data-reveal>
    <div>
      <p class="eyebrow eyebrow-light">{eyebrow}</p>
      <h2>{title}</h2>
    </div>
    <div>
      <p>{copy}</p>
      <a class="button button-inverse" href={href}>{label}<span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
