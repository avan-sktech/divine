---
import { nav, sectors, services, site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-lead">
      <p class="eyebrow eyebrow-light">Starting a project?</p>
      <h2>Build the evidence.<br />Move with confidence.</h2>
      <a class="button button-primary" href="/contact"><span aria-hidden="true">+</span> Schedule a consultation</a>
    </div>

    <div class="footer-grid">
      <div>
        <a class="brand brand-footer" href="/" aria-label="DivineLab Worx home">
          <img
            class="brand-logo"
            src="/images/divinelabworx-logo.png"
            alt="DivineLab Worx"
            width="307"
            height="180"
            loading="lazy"
            decoding="async"
          />
          <span class="brand-divider" aria-hidden="true"></span>
          <span class="brand-copy">
            <strong>Part of</strong>
            <img
              class="brand-parent-logo"
              src="/images/sharktech-global-light.png"
              alt="Sharktech Global"
              width="580"
              height="200"
              loading="lazy"
              decoding="async"
            />
          </span>
        </a>
        <p class="footer-summary">
          Business strategy, market entry and transformation for organisations building growth across Australian and international markets.
        </p>
      </div>
      <div>
        <h3>Company</h3>
        <ul>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
      <div>
        <h3>Expertise</h3>
        <ul>
          {services.slice(0, 3).map((item) => <li><a href={item.href}>{item.title}</a></li>)}
          {sectors.slice(0, 2).map((item) => <li><a href={item.href}>{item.title}</a></li>)}
        </ul>
      </div>
      <div>
        <h3>Contact</h3>
        <address>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
          <span>{site.address}</span>
          <span>ABN {site.abn}</span>
        </address>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {year} {site.legalName}</span>
      <span class="footer-legal"><a href="/privacy">Privacy</a><a href="/terms">Terms</a><a href="/llms.txt">Site information</a></span>
    </div>
  </div>
</footer>
