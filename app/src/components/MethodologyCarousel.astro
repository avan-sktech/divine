const initial = workflows['market-entry'];
---

<section class="cppd-section" aria-labelledby="cppd-title" data-cppd-carousel>
  <link rel="stylesheet" href="/components/methodology-carousel.css?v=20260728" />
  <script type="application/json" data-cppd-workflows set:html={JSON.stringify(workflows)}></script>

  <div class="cppd-heading">
    <p class="cppd-eyebrow">02 · The DivineLab Concurrent Method</p>
    <h2 id="cppd-title">One method. Five commercial applications.</h2>
    <p class="cppd-intro">
      Strategy, delivery, economics, assurance and evidence mature together.
      Choose an application to see how the decision system adapts.
    </p>
  </div>

  <div class="cppd-industry-bar">
    <label for="cppd-industry">Explore the methodology by application</label>
    <div class="cppd-select-wrap">
      <select id="cppd-industry" data-industry-select>
        {Object.entries(workflows).map(([key, workflow]) => <option value={key}>{workflow.name}</option>)}
      </select>
      <span aria-hidden="true">↓</span>
    </div>
  </div>

  <div class="cppd-answer" aria-live="polite">
    <span data-industry-kicker>{initial.kicker}</span>
    <p data-industry-answer>{initial.answer}</p>
  </div>

  <div class="cppd-shell">
    <div class="cppd-visual" aria-hidden="true">
      <div class="cppd-orbit cppd-orbit--outer"></div>
      <div class="cppd-orbit cppd-orbit--inner"></div>

      <div class="cppd-track-labels">
        {initial.tracks.map((track, index) => <span data-track-label={index}>{track}</span>)}
      </div>

      <div class="cppd-track-field">
        {initial.tracks.map((track, trackIndex) => (
          <div class="cppd-track">
            <span class="cppd-track-name" data-track-name={trackIndex}>{track}</span>
            <span class="cppd-track-line"></span>
            {initial.stages.map((stage, stageIndex) => (
              <span class="cppd-node" data-stage={stageIndex} title={`${track}: ${stage}`}></span>
            ))}
          </div>
        ))}
        <span class="cppd-scan" data-scan></span>
      </div>

      <div class="cppd-stage-row">
        {initial.stages.map((stage, stageIndex) => <span data-stage-label={stageIndex}>{stage}</span>)}
      </div>

      <div class="cppd-system-status">
        <span class="cppd-pulse"></span>
        <span>Five workstreams · one decision system</span>
      </div>
    </div>

    <div class="cppd-content">
      <div class="cppd-slides" aria-live="polite">
        {initial.slides.map((slide, index) => (
          <article class:list={['cppd-slide', { 'is-active': index === 0 }]} data-slide={index} aria-hidden={index === 0 ? 'false' : 'true'}>
            <div class="cppd-slide-meta">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <span data-slide-phase>{slide.phase}</span>
            </div>
            <h3 data-slide-title>{slide.title}</h3>
            <p data-slide-body>{slide.body}</p>
            <div class="cppd-proof">
              <span></span>
              <span data-slide-proof>{slide.proof}</span>
            </div>
          </article>
        ))}
      </div>

      <div class="cppd-controls">
        <button class="cppd-arrow" type="button" data-prev aria-label="Previous methodology step"><span aria-hidden="true">←</span></button>
        <div class="cppd-dots" role="tablist" aria-label="Concurrent methodology steps">
          {initial.slides.map((slide, index) => (
            <button class:list={['cppd-dot', { 'is-active': index === 0 }]} type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-label={`Step ${index + 1}: ${slide.phase}`} data-go={index}>
              <span></span>
            </button>
          ))}
        </div>
        <button class="cppd-arrow" type="button" data-next aria-label="Next methodology step"><span aria-hidden="true">→</span></button>
        <button class="cppd-pause" type="button" data-pause aria-label="Pause autoplay">
          <span data-pause-icon aria-hidden="true">Ⅱ</span>
          <span data-pause-label>Pause</span>
        </button>
      </div>
    </div>
  </div>

  <div class="cppd-line-of-sight" aria-label="Concurrent methodology line of sight">
    {initial.line.map((item, index) => (
      <>
        <span data-line-item={index}>{item}</span>
        {index < initial.line.length - 1 && <i aria-hidden="true">→</i>}
      </>
    ))}
  </div>

  <p class="cppd-practitioner-note">
    The DivineLab Concurrent Method applies concurrent product and process design
    principles to business strategy, commercialisation and transformation.
  </p>

  <script is:inline>
    (() => {
      const root = document.currentScript?.closest('[data-cppd-carousel]');
      if (!root || root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';

      const workflows = JSON.parse(root.querySelector('[data-cppd-workflows]').textContent);
      const slides = [...root.querySelectorAll('[data-slide]')];
      const dots = [...root.querySelectorAll('[data-go]')];
      const nodes = [...root.querySelectorAll('.cppd-node')];
      const labels = [...root.querySelectorAll('[data-stage-label]')];
      const trackLabels = [...root.querySelectorAll('[data-track-label]')];
      const trackNames = [...root.querySelectorAll('[data-track-name]')];
      const lineItems = [...root.querySelectorAll('[data-line-item]')];
      const select = root.querySelector('[data-industry-select]');
      const kicker = root.querySelector('[data-industry-kicker]');
      const answer = root.querySelector('[data-industry-answer]');
      const scan = root.querySelector('[data-scan]');
      const pause = root.querySelector('[data-pause]');
      const pauseIcon = root.querySelector('[data-pause-icon]');
      const pauseLabel = root.querySelector('[data-pause-label]');
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const duration = 6500;
      let active = 0;
      let timer;
      let paused = reducedMotion;
      let touchStart = 0;

      const positionScan = () => {
        if (!scan) return;
        const target = root.querySelector(`.cppd-node[data-stage="${active}"]`);
        if (!target) return;
        const field = scan.parentElement.getBoundingClientRect();
        const node = target.getBoundingClientRect();
        scan.style.transform = `translateX(${node.left + node.width / 2 - field.left}px)`;
      };

      const schedule = () => {
        clearTimeout(timer);
        if (!paused) timer = setTimeout(() => go(active + 1), duration);
      };

      const go = (target) => {
        active = (target + slides.length) % slides.length;
        slides.forEach((slide, index) => {
          const selected = index === active;
          slide.classList.toggle('is-active', selected);
          slide.setAttribute('aria-hidden', selected ? 'false' : 'true');
        });
        dots.forEach((dot, index) => {
          dot.classList.toggle('is-active', index === active);
          dot.classList.toggle('is-past', index < active);
          dot.setAttribute('aria-selected', index === active ? 'true' : 'false');
        });
        nodes.forEach((node) => {
          const stage = Number(node.dataset.stage);
          node.classList.toggle('is-active', stage === active);
          node.classList.toggle('is-past', stage < active);
        });
        labels.forEach((label, index) => label.classList.toggle('is-active', index === active));
        positionScan();
        schedule();
      };

      const applyWorkflow = (key) => {
        const workflow = workflows[key];
        if (!workflow) return;
        kicker.textContent = workflow.kicker;
        answer.textContent = workflow.answer;
        trackLabels.forEach((label, index) => label.textContent = workflow.tracks[index]);
        trackNames.forEach((label, index) => label.textContent = workflow.tracks[index]);
        labels.forEach((label, index) => label.textContent = workflow.stages[index]);
        lineItems.forEach((item, index) => item.textContent = workflow.line[index]);
        slides.forEach((slide, index) => {
          const content = workflow.slides[index];
          slide.querySelector('[data-slide-phase]').textContent = content.phase;
          slide.querySelector('[data-slide-title]').textContent = content.title;
          slide.querySelector('[data-slide-body]').textContent = content.body;
          slide.querySelector('[data-slide-proof]').textContent = content.proof;
          dots[index].setAttribute('aria-label', `Step ${index + 1}: ${content.phase}`);
        });
        go(0);
      };

      const updatePause = () => {
        root.classList.toggle('is-paused', paused);
        pause.setAttribute('aria-label', paused ? 'Resume autoplay' : 'Pause autoplay');
        pauseIcon.textContent = paused ? '▶' : 'Ⅱ';
        pauseLabel.textContent = paused ? 'Play' : 'Pause';
      };

      root.querySelector('[data-prev]').addEventListener('click', () => go(active - 1));
      root.querySelector('[data-next]').addEventListener('click', () => go(active + 1));
      dots.forEach((dot) => dot.addEventListener('click', () => go(Number(dot.dataset.go))));
      select.addEventListener('change', () => applyWorkflow(select.value));
      pause.addEventListener('click', () => {
        paused = !paused;
        updatePause();
        schedule();
      });
      root.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          go(active - 1);
        }
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          go(active + 1);
        }
      });
      root.addEventListener('pointerenter', () => clearTimeout(timer));
      root.addEventListener('pointerleave', schedule);
      root.addEventListener('focusin', () => clearTimeout(timer));
      root.addEventListener('focusout', (event) => {
        if (!root.contains(event.relatedTarget)) schedule();
      });
      root.addEventListener('touchstart', (event) => {
        touchStart = event.changedTouches[0].clientX;
      }, { passive: true });
      root.addEventListener('touchend', (event) => {
        const distance = event.changedTouches[0].clientX - touchStart;
        if (Math.abs(distance) > 48) go(active + (distance < 0 ? 1 : -1));
      }, { passive: true });
      addEventListener('resize', positionScan, { passive: true });

      updatePause();
      applyWorkflow(select.value);
    })();
  </script>
</section>
