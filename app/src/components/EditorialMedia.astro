---
interface Props {
  image: string;
  alt: string;
  eyebrow: string;
  caption: string;
  index: string;
  video?: string;
  position?: string;
  compact?: boolean;
}

const {
  image,
  alt,
  eyebrow,
  caption,
  index,
  video,
  position = 'center',
  compact = false,
} = Astro.props;
---

<section class:list={['editorial-media-band', { 'editorial-media-band-compact': compact }]}>
  <div class="shell">
    <figure class="editorial-media" data-reveal>
      <div class="editorial-media-visual" style={`--media-position:${position}`}>
        <img
          src={image}
          alt={alt}
          width="2000"
          height="1125"
          loading="lazy"
          decoding="async"
        />
        {
          video && (
            <video
              muted
              loop
              playsinline
              preload="none"
              poster={image}
              aria-hidden="true"
              tabindex="-1"
              data-editorial-video
            >
              <source src={video} type="video/mp4" />
            </video>
          )
        }
        <span class="editorial-media-wash" aria-hidden="true"></span>
        <span class="editorial-media-index">{index}</span>
      </div>
      <figcaption>
        <span>{eyebrow}</span>
        <p>{caption}</p>
      </figcaption>
    </figure>
  </div>
</section>
