---
interface Props {
  question: string;
  answer: string;
  label?: string;
}
const { question, answer, label = 'Direct answer' } = Astro.props;
---

<section class="answer-band" aria-labelledby="answer-heading">
  <div class="shell answer-grid" data-reveal>
    <div>
      <p class="eyebrow">{label}</p>
      <h2 id="answer-heading">{question}</h2>
    </div>
    <p>{answer}</p>
  </div>
</section>
