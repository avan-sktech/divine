<section class="strategy-filmstrip" aria-labelledby="strategy-filmstrip-title">
  <div class="shell">
    <div class="strategy-filmstrip-heading" data-reveal>
      <p class="revamp-eyebrow">Strategy in motion</p>
      <h2 id="strategy-filmstrip-title">Position. Read. Move.</h2>
      <p>
        Good strategy is not a collection of slides. It is a sequence of informed choices,
        made with a clear view of the board and the next decision.
      </p>
    </div>

    <div class="strategy-filmstrip-grid" data-reveal>
      <figure class="strategy-film strategy-film-primary">
        <video
          muted
          loop
          playsinline
          preload="none"
          poster="/images/editorial/chess-opening-poster.webp"
          aria-hidden="true"
          tabindex="-1"
          data-editorial-video
        >
          <source src="/video/editorial/chess-opening.mp4" type="video/mp4" />
        </video>
        <figcaption><span>01</span>Establish the position</figcaption>
      </figure>

      <figure class="strategy-film">
        <video
          muted
          loop
          playsinline
          preload="none"
          poster="/images/editorial/chess-collaboration-poster.webp"
          aria-hidden="true"
          tabindex="-1"
          data-editorial-video
        >
          <source src="/video/editorial/chess-collaboration.mp4" type="video/mp4" />
        </video>
        <figcaption><span>02</span>Read the whole board</figcaption>
      </figure>

      <figure class="strategy-film">
        <video
          muted
          loop
          playsinline
          preload="none"
          poster="/images/editorial/chess-executive-poster.webp"
          aria-hidden="true"
          tabindex="-1"
          data-editorial-video
        >
          <source src="/video/editorial/chess-executive.mp4" type="video/mp4" />
        </video>
        <figcaption><span>03</span>Make the next move count</figcaption>
      </figure>
    </div>
  </div>
</section>
