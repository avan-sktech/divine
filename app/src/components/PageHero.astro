---
interface Props {
  eyebrow: string;
  title: string;
  lede: string;
  index?: string;
  dark?: boolean;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const {
  eyebrow,
  title,
  lede,
  index = 'DLW / INTL',
  dark = true,
  primaryLabel = 'Start a conversation',
  primaryHref = '/contact',
  secondaryLabel,
  secondaryHref = '/capabilities',
} = Astro.props;
---

<section class:list={['page-hero', dark && 'page-hero-dark']}>
  <div class="hero-grid-pattern" aria-hidden="true"></div>
  <div class="shell page-hero-grid">
    <div class="page-hero-copy" data-reveal>
      <p class:list={['eyebrow', dark && 'eyebrow-light']}>{eyebrow}</p>
      <h1 set:html={title}></h1>
      <p class="page-hero-lede">{lede}</p>
      <div class="button-row">
        <a class="button button-primary" href={primaryHref}>{primaryLabel}<span aria-hidden="true">↗</span></a>
        {secondaryLabel && <a class:list={['button', dark ? 'button-ghost-light' : 'button-ghost']} href={secondaryHref}>{secondaryLabel}</a>}
      </div>
    </div>
    <aside class="hero-index" aria-label="Page context" data-reveal>
      <span>DivineLab Worx</span>
      <strong>{index}</strong>
      <p>Strategy<br />Intelligence<br />Delivery</p>
    </aside>
  </div>
</section>
